# ---------- files ----------

def setup():
    for d in (JOBS, LOGS, FLAGS, ARTIFACTS):
        os.makedirs(d, exist_ok=True)


def read_json(path, default=None):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def write_json(path, data):
    tmp = "%s.%d.%d.tmp" % (path, os.getpid(), threading.get_ident())
    with open(tmp, "w") as f:
        json.dump(data, f, indent=1)
    os.replace(tmp, path)


def job_path(job_id):
    return os.path.join(JOBS, job_id + ".json")


def load_job(job_id):
    return read_json(job_path(job_id))


def save_job(job):
    write_json(job_path(job["id"]), job)


def all_jobs():
    jobs = []
    for name in os.listdir(JOBS):
        if name.endswith(".json"):
            job = read_json(os.path.join(JOBS, name))
            if job:
                jobs.append(job)
    return jobs


def flag(job_id, kind):
    return os.path.join(FLAGS, "%s.%s" % (job_id, kind))


def has_flag(job_id, kind):
    return os.path.exists(flag(job_id, kind))


def set_flag(job_id, kind, on=True):
    path = flag(job_id, kind)
    if on:
        open(path, "w").close()
    elif os.path.exists(path):
        os.remove(path)


def granted(path=GRANT):
    try:
        with open(path) as f:
            return f.read().strip() or None
    except OSError:
        return None


def give_turn(path, job_id):
    with open(path + ".tmp", "w") as f:
        f.write(job_id)
    os.replace(path + ".tmp", path)


# ---------- helpers ----------

def alive(pid):
    if not pid:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def group_alive(pgid):
    if not pgid:
        return False
    try:
        os.killpg(pgid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def parse_duration(text):
    if not text:
        return None
    total = 0
    for value, unit in re.findall(r"(\d+(?:\.\d+)?)\s*([hms]?)", text.strip().lower()):
        total += float(value) * {"h": 3600, "m": 60, "s": 1, "": 60}[unit]
    return int(total) or None


def fmt_duration(seconds):
    if seconds is None:
        return "?"
    seconds = int(seconds)
    h, m = seconds // 3600, seconds % 3600 // 60
    if h:
        return "%dh%02dm" % (h, m)
    if m:
        return "%dm" % m
    return "%ds" % seconds


def fmt_time(ts):
    return time.strftime("%H:%M", time.localtime(ts)) if ts else "?"


def dashed(name):
    """A name as Claude Code puts it in scratchpad and transcript folder names: anything but letters and digits a dash."""
    return re.sub(r"[^A-Za-z0-9]", "-", name)


def project_of(path):
    """The project a path belongs to: its folder under ROOT, or its Claude Code scratchpad."""
    if not path:
        return None
    m = re.search(re.escape(ROOT) + r"/([^/]+)", path)
    if m:
        return m.group(1)
    m = re.search(re.escape(ROOT_DASHED) + r"-([^/]+?)/", path + "/")
    if not m:
        return None
    name = m.group(1)
    try:  # the dashed name back to its folder (my.film -> my-film -> my.film), also from a session in a subfolder
        return max((n for n in os.listdir(ROOT) if name == dashed(n) or name.startswith(dashed(n) + "-")),
                   key=len, default=name)
    except OSError:
        return name


def new_id(project, name):
    slug = re.sub(r"[^A-Za-z0-9_.-]+", "-", "%s-%s" % (project, name)).strip("-")[:60]
    tail = "".join(random.choice(string.ascii_lowercase) for _ in range(3))
    return "%s-%s-%s" % (time.strftime("%m%d-%H%M%S"), slug, tail)


def dispatcher_state():
    state = read_json(DISPATCHER, {}) or {}
    state["alive"] = alive(state.get("pid")) and time.time() - state.get("beat", 0) < 30
    return state


# ---------- tools: which of Blender, Python and ffmpeg a job runs ----------

TOOL_ORDER = ("blender", "python", "ffmpeg")
SKIP_WORDS = {"nice", "env", "caffeinate", "time", "exec", "nohup", "command", "then", "do", "else", "elif", "if",
              "while", "until", "!", "{", "(", "sudo"}
SETUP_WORDS = {"cd", "set", "setopt", "export", "source", ".", "trap", "umask", "unset", "true", "rm", "mkdir", "cp",
               "mv", "ln", "touch", "echo", "printf", ":", "for", "done", "fi", "local", "log", "shift", "return",
               "exit", "test", "[", "[[", "case", "esac", "wait", "sleep", "cat", "tee", "grep", "sed", "awk", "ls"}
UV_VALUE_FLAGS = {"--with", "--project", "--python", "-p", "--directory", "--group", "--extra", "--env-file"}
_tool_cache = {}


def tool_of_word(word):
    base = os.path.basename(word.strip("\"'")).lower()
    if base == "blender":
        return "blender"
    if base in ("ffmpeg", "ffprobe"):
        return "ffmpeg"
    if re.match(r"^python[0-9.]*$", base) or base == "py" or base.endswith(".py"):
        return "python"
    return None


def program_words(text):
    """The program word of each shell command in a script or command line, with the words after it."""
    text = re.sub(r"\\\n", " ", text)
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        for part in re.split(r"&&|\|\||;|\||\$\(|`", line):
            words = part.split()
            i = 0
            while i < len(words) and (words[i] in SKIP_WORDS or re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", words[i])
                                      or words[i].startswith("-") or words[i].isdigit()):
                i += 1
            if i >= len(words) or os.path.basename(words[i]) in SETUP_WORDS or words[i].endswith("()"):
                continue
            if words[i] == "uv" and i + 1 < len(words) and words[i + 1] == "run":
                i += 2
                while i < len(words) and words[i].startswith("-"):
                    i += 2 if words[i] in UV_VALUE_FLAGS else 1
                if i >= len(words):
                    continue
            yield words[i], words[i + 1:]


def script_path(word, args, cwd, here):
    """The script file a program word runs (itself, or the script a shell is given), if it can be found."""
    if os.path.basename(word) in ("sh", "zsh", "bash"):
        args = [a for a in args if not a.startswith("-")]
        if not args:
            return None
        word = args[0]
    if "$" in word:
        return None
    for base in (cwd, here):
        path = os.path.normpath(os.path.join(base or "/", os.path.expanduser(word)))
        if os.path.isfile(path):
            return path
    return None


def read_script(path):
    try:
        if os.path.getsize(path) > 400000:
            return None
        with open(path, "rb") as f:
            data = f.read()
        return None if b"\0" in data[:4096] else data.decode("utf-8", "replace")
    except OSError:
        return None


def detect_tools(command, cwd, here=None, depth=0):
    """Blender, Python and ffmpeg as the command, or the scripts it runs (two levels deep), call them."""
    found = []
    for word, args in program_words(command):
        tool = tool_of_word(word)
        if tool:
            found.append(tool)
        path = script_path(word, args, cwd, here) if depth < 2 else None
        if not path:
            continue
        key = (path, os.path.getmtime(path), depth)
        if key not in _tool_cache:
            text = read_script(path) or ""
            if path.endswith(".py"):  # a Python script, and the programs it starts
                inner = ["python"] + [t for t in ("blender", "ffmpeg")
                                      if re.search(r"""["'](?:[^"']*/)?%s["']""" % t, text, re.I)]
            else:
                inner = detect_tools(text, cwd, os.path.dirname(path), depth + 1)
            _tool_cache[key] = inner
        found += _tool_cache[key]
    return [t for t in TOOL_ORDER if t in found]


# ---------- estimates ----------

def expected_duration(job, history):
    if job.get("estimate"):
        return job["estimate"]
    same = [h["finished"] - h["started"] for h in history
            if h["project"] == job["project"] and h["name"] == job["name"]]
    if same:
        return int(statistics.median(same))
    return None


def with_tools(jobs):
    for job in jobs:
        if "tools" not in job:
            try:
                job["tools"] = detect_tools(job["command"], job["cwd"])
            except Exception:
                job["tools"] = []
    return jobs


def snapshot():
    """Everything the status command and page show, with expected start and end times."""
    jobs = with_tools(all_jobs())
    now = time.time()
    history = sorted([j for j in jobs if j["status"] == "done" and j.get("started") and j.get("finished")
                      and j.get("kind") != "light"],
                     key=lambda j: j["finished"])
    grant = granted()
    current = next((j for j in jobs if j["id"] == grant and j["status"] not in TERMINAL), None)
    queued = queue_order([j for j in jobs if j["status"] == "queued" and j.get("kind") != "light"
                          and not has_flag(j["id"], "cancel")])
    light = sorted([j for j in jobs if j.get("kind") == "light" and j["status"] in ("granted", "running")],
                   key=lambda j: j["submitted"])
    light_queued = queue_order([j for j in jobs if j.get("kind") == "light" and j["status"] == "queued"
                                and not has_flag(j["id"], "cancel")])
    for job in light:
        job["elapsed"] = now - (job.get("started") or job["submitted"])
    d = dispatcher_state()
    # while the queue waits for renders outside it, nobody knows when they end, so start times are unknown
    t = None if (not current and d.get("alive") and any(not w.get("low") for w in d.get("warnings", []))) else now
    if current:
        exp = expected_duration(current, history)
        started = current.get("resumed") or current.get("started") or now  # a moved job: its estimate is what remains
        current["expected"] = exp
        current["elapsed"] = now - started
        current["paused"] = has_flag(current["id"], "paused")
        current["eta"] = started + exp if exp else None
        t = max(current["eta"], now) if current["eta"] else None
    for job in queued:
        exp = expected_duration(job, history)
        job["expected"] = exp
        job["eta_start"] = t
        t = t + exp if (t and exp) else None
        job["eta"] = t
    finished = sorted([j for j in jobs if j["status"] in TERMINAL], key=lambda j: j.get("finished") or 0,
                      reverse=True)[:25]
    return {"now": now, "dispatcher": d, "running": current, "queued": queued, "light": light,
            "light_queued": light_queued,
            "finished": finished, "all_done": t if (current or queued) else now}


def queue_view(jobs):
    """The queue as waiting clients need it: both queues' order and what runs now (published in dispatcher.json)."""
    grant = granted()
    heavy = queue_order([j for j in jobs if j["status"] == "queued" and j.get("kind") != "light"
                         and not has_flag(j["id"], "cancel")])
    light = queue_order([j for j in jobs if j.get("kind") == "light" and j["status"] == "queued"
                         and not has_flag(j["id"], "cancel")])
    running = next((j for j in jobs if j["id"] == grant and j["status"] not in TERMINAL), None)
    light_now = [j for j in jobs if j.get("kind") == "light" and j["status"] in ("granted", "running")]
    brief = lambda j: {"project": j["project"], "name": j["name"]}
    return {"main": [j["id"] for j in heavy], "light": [j["id"] for j in light],
            "running": brief(running) if running else None, "light_running": [brief(j) for j in light_now]}


def queue_place(job_id, light, cache):
    """(position, what runs now) for a waiting job, from the dispatcher's published queue; from an old dispatcher
    that doesn't publish it, a full snapshot at most every 15 s."""
    d = dispatcher_state()
    q = d.get("queue")
    if q is None:
        if time.time() - cache.get("at", 0) >= 15:
            snap = snapshot()
            cache.update(at=time.time(), q={"main": [j["id"] for j in snap["queued"]],
                                            "light": [j["id"] for j in snap["light_queued"]],
                                            "running": snap["running"], "light_running": snap["light"]})
        q = cache.get("q") or {}
    line = q.get("light" if light else "main") or []
    position = line.index(job_id) + 1 if job_id in line else None
    now = (q.get("light_running") or [None])[0] if light else q.get("running")
    return position, now, d


def queue_order(queued):
    first = read_json(ORDER, []) or []
    rank = {job_id: i for i, job_id in enumerate(first)}
    return sorted(queued, key=lambda j: (rank.get(j["id"], len(rank)), j["submitted"]))


# ---------- strays: heavy processes outside the queue ----------

def processes():
    out = subprocess.run(["ps", "-Ao", "pid=,ppid=,pgid=,nice=,stat=,pcpu=,comm="],
                         capture_output=True, text=True).stdout
    procs = {}
    for line in out.splitlines():
        parts = line.split(None, 6)
        if len(parts) < 7:
            continue
        pid, ppid, pgid, nice, stat, cpu, comm = parts
        try:
            procs[int(pid)] = {"pid": int(pid), "ppid": int(ppid), "pgid": int(pgid), "nice": int(nice),
                               "stat": stat, "cpu": float(cpu), "comm": comm}
        except ValueError:
            continue
    return procs


def cwd_of(pid):
    out = subprocess.run(["lsof", "-a", "-p", str(pid), "-d", "cwd", "-Fn"], capture_output=True, text=True).stdout
    for line in out.splitlines():
        if line.startswith("n"):
            return line[1:]
    return None


def rq_pids():
    """The processes of rq itself: waiting or running clients and the dispatcher (their jobs are other processes)."""
    me = os.path.join(HOME, "rq")
    out = subprocess.run(["ps", "-Ao", "pid=,args="], capture_output=True, text=True).stdout
    pids = set()
    for line in out.splitlines():
        parts = line.strip().split(None, 1)
        if len(parts) == 2 and parts[0].isdigit() and (me + " " in parts[1] or parts[1].endswith(me)):
            pids.add(int(parts[0]))
    return pids


def strays(jobs=()):
    """Heavy work outside the queue, at normal priority (nice below QUIET_NICE), per process group: a busy or paused
    Blender or ffmpeg (an encoder waiting for frames counts while its pipeline works), or a project's group
    using more than about one core in total (e.g. a Python step)."""
    if os.environ.get("RQ_IGNORE_OUTSIDE"):  # tests only
        return []
    procs = processes()
    roots = {j["pid"] for j in jobs if j.get("pid")}
    pgids = {j["pgid"] for j in jobs if j.get("pgid")}
    mine = set()
    for p in procs.values():
        q, seen = p, 0
        while q and seen < 50:
            if q["pid"] in roots or q["pgid"] in pgids:
                mine.add(p["pid"])
                break
            q, seen = procs.get(q["ppid"]), seen + 1
    ours = rq_pids()
    groups = {}
    for p in procs.values():
        if p["pid"] in mine or p["pid"] in ours or "claude" in p["comm"].lower():
            continue
        groups.setdefault((p["pgid"], p["nice"] >= QUIET_NICE), []).append(p)
    found = {}
    for (pgid, low), members in groups.items():
        cpu = sum(p["cpu"] for p in members)
        renderers = [p for p in members if os.path.basename(p["comm"]).lower() in ("blender", "ffmpeg")]
        paused = bool(renderers) and all(p["stat"].startswith("T") for p in renderers)
        if renderers:
            parent_cpu = max((procs.get(p["ppid"]) or {}).get("cpu", 0) for p in renderers)
            if not paused and cpu < 5 and parent_cpu < 5:
                continue
        elif cpu < GROUP_HEAVY_CPU:
            continue
        lead = max(renderers or members, key=lambda p: p["cpu"])
        cwd = cwd_of(lead["pid"])
        project = project_of(cwd)
        if project == SELF or (not renderers and not project):
            continue
        project = project or "?"
        what = os.path.basename(lead["comm"]).lower()
        if low and (paused or cpu < GROUP_HEAVY_CPU):  # low priority: only heavy, running work is worth showing
            continue
        entry = found.setdefault((project, what, low), {"pid": lead["pid"], "what": what, "project": project,
                                                        "cwd": cwd, "paused": paused, "count": 0, "cpu": 0, "low": low})
        entry["count"] += len(renderers or members)
        entry["cpu"] += cpu
        entry["paused"] = entry["paused"] and paused
    return list(found.values())


def describe(found):
    return ", ".join("%s %s%s (%s)%s" % (s["project"], s["what"], " paused" if s["paused"] else "",
                                         "%d processes" % s["count"] if s.get("count", 1) > 1 else "pid %d" % s["pid"],
                                         " (light, not holding the queue)" if s.get("low") else "")
                     for s in found)


# ---------- core usage ----------

def all_cwds():
    out = subprocess.run(["lsof", "-d", "cwd", "-Fpn"], capture_output=True, text=True).stdout
    cwds, pid = {}, None
    for line in out.splitlines():
        if line.startswith("p"):
            pid = int(line[1:])
        elif line.startswith("n") and pid:
            cwds[pid] = line[1:]
    return cwds


def core_usage():
    """Cores in use per project (by working directory, or a parent's), and on the whole machine (the bar's "others" is the difference)."""
    procs = processes()
    cwds = all_cwds()
    own = {}
    for pid in procs:
        project = project_of(cwds.get(pid))
        if project and project != SELF:
            own[pid] = project

    def owner(pid):
        q, seen = procs.get(pid), 0
        while q and seen < 30:
            if q["pid"] in own:
                return own[q["pid"]]
            q, seen = procs.get(q["ppid"]), seen + 1
        return None
    projects = {}
    for p in procs.values():
        if p["cpu"] <= 0:
            continue
        project = owner(p["pid"])
        if not project:
            continue
        entry = projects.setdefault(project, {"cores": 0.0, "low": 0.0})
        entry["cores"] += p["cpu"] / 100
        if p["nice"] >= QUIET_NICE:
            entry["low"] += p["cpu"] / 100
    for entry in projects.values():
        entry["cores"] = round(entry["cores"], 2)
        entry["low"] = round(entry["low"], 2)
    return {"at": time.time(), "cores": os.cpu_count(), "machine": round(sum(p["cpu"] for p in procs.values()) / 100, 2),
            "sessions": round(sum(e["cores"] for e in projects.values()), 2), "projects": projects}


def gpu_sample():
    """The GPU's device utilization (%) and core count, as macOS reports them without admin rights (whole GPU)."""
    out = subprocess.run(["ioreg", "-r", "-d", "1", "-c", "IOAccelerator"], capture_output=True, text=True).stdout
    util = re.search(r'"Device Utilization %"=(\d+)', out)
    cores = re.search(r'"gpu-core-count" = (\d+)', out)
    return (int(util.group(1)) if util else None), (int(cores.group(1)) if cores else None)


# ---------- sessions waiting for the user ----------

SESSIONS = os.path.join(STATE, "sessions.json")  # {project: link to its session or null}, the sessions to watch
CHATS = os.path.join(os.path.expanduser("~/.claude/projects"), ROOT_DASHED + "-")  # + project: its transcripts


def utc_ts(text):
    import calendar
    try:
        return calendar.timegm(time.strptime(text[:19], "%Y-%m-%dT%H:%M:%S"))
    except (TypeError, ValueError):
        return None


def last_turn(path):
    """The last entry of the latest turn that wasn't started by another session (a peer message) and ended, or the
    last entry of all if a turn is still under way. Reads only the transcript's tail."""
    try:
        with open(path, "rb") as f:
            f.seek(max(0, os.path.getsize(path) - 1048576))
            lines = f.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return None
    turns = []  # [starter kind, last user/assistant entry]
    last = None
    for line in lines:
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        if entry.get("type") not in ("user", "assistant") or entry.get("isSidechain"):
            continue
        last = entry
        content = (entry.get("message") or {}).get("content")
        prompt = entry["type"] == "user" and not (isinstance(content, list) and any(
            isinstance(c, dict) and c.get("type") == "tool_result" for c in content))
        if prompt:
            turns.append([(entry.get("origin") or {}).get("kind") or "human", entry])
        elif turns:
            turns[-1][1] = entry
    if not last:
        return None
    ended = lambda e: e["type"] == "assistant" and (e.get("message") or {}).get("stop_reason") == "end_turn"
    if not ended(last):
        return last  # a turn is under way: working, a question or a permission prompt
    for kind, entry in reversed(turns):
        if kind != "peer" and ended(entry):
            return entry
    return last


def session_states():
    """Per session: waiting for the user (turn ended, a question, maybe a permission prompt) or working.
    Read from each session's chat transcript tail and its Claude process, never by asking the session."""
    links = read_json(SESSIONS, {}) or {}
    out = subprocess.run(["ps", "-Ao", "pid=,ppid=,command="], capture_output=True, text=True).stdout
    procs = []
    for line in out.splitlines():
        parts = line.split(None, 2)
        if len(parts) == 3 and parts[0].isdigit() and parts[1].isdigit():
            procs.append((int(parts[0]), int(parts[1]), parts[2]))
    children = {}
    for pid, ppid, command in procs:
        children.setdefault(ppid, []).append(command)
    resumed = {}  # transcript id -> the session's claude process
    for pid, ppid, command in procs:
        m = re.search(r"/claude\.app/Contents/MacOS/claude .*--resume=([0-9a-f-]{36})", command)
        if m and "disclaimer" not in command.split()[0]:  # the session itself, not its launcher
            resumed[m.group(1)] = pid
    now = time.time()
    jobs = {}  # a project's jobs in rq: queued or running
    for job in all_jobs():
        if job["status"] in ("queued", "granted", "running"):
            counts = jobs.setdefault(job["project"], {"running": 0, "queued": 0})
            counts["queued" if job["status"] == "queued" else "running"] += 1
    states = []
    for project in sorted(links):
        folder = CHATS + dashed(project)
        try:
            chats = [os.path.join(folder, n) for n in os.listdir(folder) if n.endswith(".jsonl")]
        except OSError:
            continue
        live = [c for c in chats if os.path.basename(c)[:-6] in resumed]
        if resumed and not live:
            continue  # sessions run as processes here, and this one has none: it was archived or closed
        chat = max(live or chats, key=os.path.getmtime, default=None)
        if not chat:
            continue
        entry = last_turn(chat)
        if not entry:
            continue
        claude = resumed.get(os.path.basename(chat)[:-6])
        shells = [c for c in children.get(claude, []) if "shell-snapshots" in c or c.startswith("/bin/zsh -c")]
        msg = entry.get("message") or {}
        content = msg.get("content") if isinstance(msg.get("content"), list) else []
        since = utc_ts(entry.get("timestamp") or "")
        tool = next((c for c in reversed(content) if isinstance(c, dict) and c.get("type") == "tool_use"), None)
        state = "working"
        if entry["type"] == "assistant" and msg.get("stop_reason") == "end_turn":
            state = "jobs" if project in jobs else "waiting"  # with jobs in rq, it waits for them, not for the user
        elif entry["type"] == "assistant" and tool:
            if tool.get("name") == "AskUserQuestion":
                state = "question"
            elif since and now - since > 30 and not shells:
                state = "permission"
        states.append({"project": project, "state": state, "since": since, "link": links.get(project),
                       "background": len(shells) if state == "waiting" else 0,
                       "tool": tool.get("name") if tool and state == "permission" else None,
                       "jobs": jobs.get(project)})
    return states


# ---------- artifacts: the pictures and videos a finished job produced ----------

IMAGE_EXT = {".png", ".jpg", ".jpeg", ".webp", ".gif", ".avif", ".bmp", ".tif", ".tiff", ".heic", ".exr"}
VIDEO_EXT = {".mp4", ".mov", ".m4v", ".webm", ".mkv", ".avi"}
MEDIA_EXT = IMAGE_EXT | VIDEO_EXT
NO_BROWSER_EXT = {".exr"}  # no browser shows these: the page offers to open them on the Mac instead
SKIP_DIRS = {".git", ".venv", "venv", "node_modules", "__pycache__", ".cache", ".mypy_cache", ".pytest_cache"}
SCRATCH_GLOB = os.environ.get("RQ_SCRATCH_GLOB", "/private/tmp/claude-%d/" % os.getuid())  # this user's scratchpads
ARTIFACT_GRACE = 5  # seconds after a job ends that its files may still land
ARTIFACT_SETTLE = 8  # seconds to wait after a job ends before looking for its files
ARTIFACT_DAYS = 2  # how far back the dispatcher looks for jobs without artifacts (older ones: when opened)
MAX_SINGLES = 500  # single pictures and videos kept per job; sequences are always kept
SEQUENCE_MIN = 24  # numbered pictures in one folder that make a sequence (animation frames, not a few stills)
_SEQ = re.compile(r"^(.*?)(\d+)(\.[A-Za-z0-9]+)$")
for _type, _ext in (("video/quicktime", ".mov"), ("video/mp4", ".m4v"), ("video/webm", ".webm"),
                    ("video/x-matroska", ".mkv"), ("image/webp", ".webp"), ("image/avif", ".avif"),
                    ("image/heic", ".heic"), ("image/x-exr", ".exr")):
    mimetypes.add_type(_type, _ext)


def open_stop(job, now=None):
    """The job's stopped intervals with a new one starting now (paused in the queue, or rq pause)."""
    stops = [list(x) for x in job.get("stopped") or []]
    if not stops or stops[-1][1] is not None:
        stops.append([now or time.time(), None])
    return stops


def close_stop(job, now=None):
    stops = [list(x) for x in job.get("stopped") or []]
    if stops and stops[-1][1] is None:
        stops[-1][1] = now or time.time()
    return stops


def project_dirs(project):
    """A project's folder and this user's Claude Code scratchpad folders of it (also of sessions in its subfolders)."""
    dirs = [os.path.realpath(os.path.join(ROOT, project))]
    for d in glob.glob(SCRATCH_GLOB + ROOT_DASHED + "-" + dashed(project) + "*"):
        try:
            if os.path.isdir(d) and os.stat(d).st_uid == os.getuid() and project_of(d + "/") == project:
                dirs.append(os.path.realpath(d))
        except OSError:
            continue
    return dirs


def inside(path, tops):
    return any(path == t or path.startswith(t.rstrip("/") + "/") for t in tops)


def media_files(project):
    """{real path: (mtime, size)} of every picture and video file in a project's folders. Folders reached through a
    symlink are not followed (snapshots link back into the project); a symlinked file counts only if it leads to a
    regular picture or video file inside the project's own folders. The queue's own folder is skipped."""
    tops = project_dirs(project)
    found = {}
    for top in tops:
        stack = [top]
        while stack:
            folder = stack.pop()
            if folder == HOME:
                continue
            try:
                entries = list(os.scandir(folder))
            except OSError:
                continue
            for e in entries:
                if e.name in SKIP_DIRS:
                    continue
                try:
                    if e.is_dir(follow_symlinks=False):
                        stack.append(e.path)
                        continue
                    if os.path.splitext(e.name)[1].lower() not in MEDIA_EXT:
                        continue
                    if e.is_symlink():
                        path = os.path.realpath(e.path)
                        if os.path.splitext(path)[1].lower() not in MEDIA_EXT or not inside(path, tops):
                            continue
                        st = os.stat(path)
                    else:
                        path, st = e.path, e.stat(follow_symlinks=False)
                    if not stat.S_ISREG(st.st_mode) or path in found:
                        continue
                    found[path] = (st.st_mtime, st.st_size)
                except OSError:
                    continue
    return found


def job_end(job, now):
    """When a job stopped producing files: its end, or for a lost job the last write to its log (the dispatcher
    may notice a dead client long after it died)."""
    if job["status"] not in TERMINAL:
        return now
    end = job.get("finished") or now
    if job["status"] == "lost":
        try:
            end = min(end, max(job["started"], os.path.getmtime(os.path.join(LOGS, job["id"] + ".log"))))
        except OSError:
            pass
    return end


def job_runs(job, now=None):
    """The intervals in which a job was really running (without the time it was stopped), or [] if it never ran."""
    if not job.get("started"):
        return []
    now = now or time.time()
    end = job_end(job, now)
    stops = [list(x) for x in job.get("stopped") or []]
    if not stops and job.get("promoted"):  # records from before stops were kept
        stops = [[job["promoted"], job.get("resumed")]]
    runs, t = [], job["started"]
    for a, b in sorted(stops, key=lambda x: x[0]):
        b = end if b is None else b
        if a > t:
            runs.append((t, min(a, end)))
        t = max(t, b)
    if t < end:
        runs.append((t, end))
    return [r for r in runs if r[1] >= r[0]] or [(job["started"], job["started"])]


def peer(job, base, now):
    """A job prepared for attribution: its running intervals, the same with a little slack, its working folder."""
    runs = job_runs(job, now)
    if not runs:
        return None
    cwd = os.path.realpath(job.get("cwd") or "/").rstrip("/")
    return dict(job, _runs=runs, _slack=[(runs[0][0] - 1, runs[-1][1] + ARTIFACT_GRACE)],
                _span=(runs[0][0] - 1, runs[-1][1] + ARTIFACT_GRACE), _active=sum(b - a for a, b in runs),
                _cwd=None if cwd in (base, ROOT, "") else cwd)


def owner_of(path, mtime, candidates):
    """Of the jobs that could have written a file: the ones really running at its mtime (else those within the
    slack), then the one running in the file's folder (deepest working folder), then the shortest."""
    live = [j for j in candidates if any(a <= mtime <= b for a, b in j["_runs"])]
    pool = live or [j for j in candidates if any(a <= mtime <= b for a, b in j["_slack"])]
    if not pool:
        return None
    shortest = lambda j: (j["_active"], j["id"])
    in_folder = [j for j in pool if j["_cwd"] and (path + "/").startswith(j["_cwd"] + "/")]
    if in_folder:
        depth = max(len(j["_cwd"]) for j in in_folder)
        return min((j for j in in_folder if len(j["_cwd"]) == depth), key=shortest)
    return min(pool, key=shortest)


def sequence_key(path):
    """(folder, prefix, extension, number, digits) of a numbered picture, else None."""
    ext = os.path.splitext(path)[1].lower()
    m = _SEQ.match(os.path.basename(path))
    if not m or ext not in IMAGE_EXT:
        return None
    return os.path.dirname(path), m.group(1), m.group(3), int(m.group(2)), m.group(2)


def item_key(*parts):
    """A short stable id for an artifact (its URL keeps working when the list is rebuilt)."""
    return hashlib.sha1("\0".join(str(p) for p in parts).encode()).hexdigest()[:12]


def frame_width(frames):
    """The zero padding of a sequence's numbers (0: none), or None if they mix padded and unpadded numbering."""
    digits = [d for _, d, _, _, _ in frames]
    width = min(len(d) for d in digits)
    if all(d == "%0*d" % (width, n) for n, d, _, _, _ in frames):
        return width if len({len(d) for d in digits}) == 1 or any(d.startswith("0") for d in digits) else 0
    return None


def group_media(files):
    """Pictures and videos as items. Numbered pictures in one folder (padded or not) become a sequence, with its
    frames as ranges; numbered videos stay single videos."""
    groups, singles = {}, []
    for path, (mtime, size) in files.items():
        k = sequence_key(path)
        if k:
            groups.setdefault(k[:3], []).append((k[3], k[4], path, mtime, size))
        else:
            singles.append((path, mtime, size))
    items = []
    for (folder, prefix, ext), frames in groups.items():
        width = frame_width(frames)
        if len(frames) < SEQUENCE_MIN or width is None:
            singles += [(p, mt, sz) for _, _, p, mt, sz in frames]  # a few stills, or mixed numbering
            continue
        numbers = sorted({n for n, _, _, _, _ in frames})
        ranges = []
        for n in numbers:
            if ranges and n == ranges[-1][1] + 1:
                ranges[-1][1] = n
            else:
                ranges.append([n, n])
        items.append({"kind": "sequence", "key": item_key(folder, prefix, ext), "media": "image", "dir": folder,
                      "prefix": prefix, "width": width, "ext": ext, "frames": ranges, "count": len(numbers),
                      "size": sum(sz for _, _, _, _, sz in frames), "mtime": max(mt for _, _, _, mt, _ in frames)})
    singles.sort(key=lambda f: -f[1])
    for path, mtime, size in singles:
        ext = os.path.splitext(path)[1].lower()
        items.append({"kind": "video" if ext in VIDEO_EXT else "image", "key": item_key(path), "path": path,
                      "size": size, "mtime": mtime})
    order = {"video": 0, "image": 1, "sequence": 2}
    items.sort(key=lambda i: (order[i["kind"]], -i["mtime"]))
    kept, truncated, n_singles = [], 0, 0
    for item in items:
        if item["kind"] != "sequence":
            n_singles += 1
            if n_singles > MAX_SINGLES:
                truncated += 1
                continue
        kept.append(item)
    return kept, truncated


def save_artifacts(job, items, truncated, now):
    write_json(os.path.join(ARTIFACTS, job["id"] + ".json"), {"at": now, "items": items, "truncated": truncated})
    kinds = {}
    for item in items:
        kinds[item["kind"]] = kinds.get(item["kind"], 0) + 1
    fresh = load_job(job["id"]) or job  # keep anything its client wrote meanwhile
    fresh["artifacts"] = {"at": now, "count": len(items) + truncated, "kinds": kinds}
    save_job(fresh)
    job.update(fresh)


def index_artifacts(targets, jobs):
    """Find and save the artifacts of finished jobs, with one scan per project. Every file goes to the job that
    wrote it (owner_of); a frame sequence goes as a whole to the job that wrote most of its frames."""
    now = time.time()
    by_project = {}
    for job in targets:
        if job["project"] == SELF or not job.get("started"):
            save_artifacts(job, [], 0, now)  # nothing to look for
        else:
            by_project.setdefault(job["project"], []).append(job)
    for project, mine in by_project.items():
        base = os.path.realpath(os.path.join(ROOT, project))
        files = sorted((mtime, path, size) for path, (mtime, size) in media_files(project).items())
        times = [f[0] for f in files]
        peers = sorted((p for p in (peer(j, base, now) for j in jobs if j["project"] == project) if p),
                       key=lambda p: p["_span"][0])
        starts = [p["_span"][0] for p in peers]
        targets_p = [p for p in (peer(j, base, now) for j in mine) if p]

        def candidates(mtime):
            return [p for p in peers[:bisect.bisect_right(starts, mtime)] if p["_span"][1] >= mtime]

        # the files the targets could own, and every frame of any sequence they touch
        wanted, touched = {}, set()
        for t in targets_p:
            lo, hi = t["_span"]
            for mtime, path, size in files[bisect.bisect_left(times, lo):bisect.bisect_right(times, hi)]:
                wanted[path] = (mtime, size)
                k = sequence_key(path)
                if k:
                    touched.add(k[:3])
        if touched:
            for mtime, path, size in files:
                k = sequence_key(path)
                if k and k[:3] in touched:
                    wanted[path] = (mtime, size)
        owner = {path: owner_of(path, mt, candidates(mt)) for path, (mt, sz) in wanted.items()}
        votes = {}
        for path, o in owner.items():
            k = sequence_key(path)
            if k and o:
                votes.setdefault(k[:3], {}).setdefault(o["id"], 0)
                votes[k[:3]][o["id"]] += 1
        for path in owner:
            k = sequence_key(path)
            if k and k[:3] in votes and sum(votes[k[:3]].values()) >= SEQUENCE_MIN:
                winner = max(votes[k[:3]].items(), key=lambda kv: (kv[1], kv[0]))[0]
                owner[path] = {"id": winner}
        for job in mine:
            owned = {p: wanted[p] for p, o in owner.items() if o and o["id"] == job["id"]}
            items, truncated = group_media(owned)
            save_artifacts(job, items, truncated, now)


def needs_artifacts(job, now):
    if job["status"] not in TERMINAL or not job.get("finished") or now - job["finished"] < ARTIFACT_SETTLE:
        return False
    if now - job["finished"] > ARTIFACT_DAYS * 86400:
        return False
    a = job.get("artifacts")
    return not a or a.get("at", 0) < job["finished"] + ARTIFACT_SETTLE - 1


def artifact_indexer():
    """Dispatcher thread: soon after a job ends, find what it produced (scans take seconds, so not in the loop)."""
    while True:
        try:
            now = time.time()
            jobs = all_jobs()
            targets = sorted((j for j in jobs if needs_artifacts(j, now)), key=lambda j: -j["finished"])[:2000]
            if targets:
                index_artifacts(targets, jobs)
        except Exception as e:
            print("rq: artifact indexer: %r" % e, flush=True)
        time.sleep(10)


def frame_path(item, frame):
    if not any(a <= frame <= b for a, b in item["frames"]):
        return None
    return os.path.join(item["dir"], "%s%0*d%s" % (item["prefix"], item["width"], frame, item["ext"]))


def display_path(path, project):
    """A path as the page shows it: relative to the project folder, or scratch/... inside a scratchpad."""
    base = os.path.realpath(os.path.join(ROOT, project))
    if (path + "/").startswith(base + "/"):
        return os.path.relpath(path, base)
    m = re.search(r"/scratchpad/(.*)$", path)
    if m:
        return "scratch/" + m.group(1)
    return os.path.basename(path)


def load_artifacts(job_id):
    return read_json(os.path.join(ARTIFACTS, job_id + ".json"), {}) or {}


def job_artifacts(job):
    """A job's artifacts for the page (found now if the dispatcher hasn't yet), without absolute paths."""
    a = load_artifacts(job["id"])
    if job["status"] in TERMINAL and not a:
        index_artifacts([job], all_jobs())
        a = load_artifacts(job["id"])
    runs = job_runs(job)
    until = (runs[-1][1] + ARTIFACT_GRACE) if runs else 0
    out = []
    for item in a.get("items", []):
        ext = (item.get("ext") or os.path.splitext(item.get("path", ""))[1]).lower()
        view = dict(key=item.get("key") or "", kind=item["kind"], size=item["size"], mtime=item["mtime"], ext=ext,
                    browser=ext not in NO_BROWSER_EXT)
        if item["kind"] == "sequence":
            view.update(media=item["media"], frames=item["frames"], count=item["count"], width=item["width"],
                        name="%s%s%s" % (item["prefix"], "#" * max(item["width"], 1), item["ext"]),
                        dir=display_path(item["dir"], job["project"]), exists=os.path.isdir(item["dir"]))
        else:
            try:
                now_mtime = os.stat(item["path"]).st_mtime
                exists = True
            except OSError:
                now_mtime, exists = None, False
            view.update(name=os.path.basename(item["path"]),
                        dir=os.path.dirname(display_path(item["path"], job["project"])), exists=exists,
                        changed=bool(exists and until and now_mtime > until))
        out.append(view)
    return {"id": job["id"], "project": job["project"], "name": job["name"], "status": job["status"],
            "kind": job.get("kind"), "tools": job.get("tools"), "command": job.get("command"),
            "started": job.get("started"), "finished": job.get("finished"), "exit": job.get("exit"),
            "artifacts": out, "truncated": a.get("truncated", 0), "indexed": bool(a),
            "pending": job["status"] not in TERMINAL}


def artifact_target(job_id, key, frame=None):
    """The file (or the folder, for a whole sequence) an artifact key names, re-checked on disk: a regular picture
    or video file inside the project's own folders, never anything a symlink swapped in since."""
    if not re.match(r"^[A-Za-z0-9_.-]+$", job_id or "") or not re.match(r"^[0-9a-f]{12}$", key or ""):
        return None
    job = load_job(job_id)
    item = next((i for i in load_artifacts(job_id).get("items") or [] if i.get("key") == key), None)
    if not job or not item:
        return None
    tops = project_dirs(job["project"])
    if item["kind"] == "sequence" and frame is None:
        path = os.path.realpath(item["dir"])
        return path if os.path.isdir(path) and inside(path, tops) else None
    path = frame_path(item, frame) if item["kind"] == "sequence" else item["path"] if frame is None else None
    if not path:
        return None
    path = os.path.realpath(path)
    try:
        ok = stat.S_ISREG(os.stat(path).st_mode)
    except OSError:
        return None
    return path if ok and os.path.splitext(path)[1].lower() in MEDIA_EXT and inside(path, tops) else None


# ---------- dispatcher ----------

def repair_grants(jobs):
    """A job marked granted that holds no turn (the dispatcher stopped between the two writes) goes back in line."""
    turns = {granted(GRANT), granted(GRANT_LIGHT)}
    for job in jobs.values():
        if job["status"] == "granted" and job["id"] not in turns:
            job["status"] = "queued"
            save_job(job)


def dispatch_light(jobs):
    """The light queue: one light job at a time, oldest first. A running light job (also one started before this
    queue existed) holds the slot; one that ran over the cap and moved into the main queue frees it."""
    turn = granted(GRANT_LIGHT)
    if turn:
        job = load_job(turn)
        if not job or job["status"] in TERMINAL or job.get("kind") != "light":
            os.remove(GRANT_LIGHT)
            turn = None
    if turn:
        return
    current = [j for j in all_jobs() if j.get("kind") == "light" and j["status"] in ("granted", "running")]
    if current:
        return
    waiting = queue_order([j for j in all_jobs() if j.get("kind") == "light" and j["status"] == "queued"])
    if waiting:
        job = waiting[0]
        give_turn(GRANT_LIGHT, job["id"])
        job.update(status="granted", granted=time.time())
        save_job(job)


def dispatch_once(state):
    jobs = {j["id"]: j for j in all_jobs()}
    for job in jobs.values():
        if job.get("kind") == "light" and job["status"] not in TERMINAL and not alive(job.get("client_pid")) \
                and not group_alive(job.get("pgid")):
            job.update(status="lost", finished=time.time())
            save_job(job)
    for job in jobs.values():  # queued light jobs whose session is gone or that were cancelled
        if job.get("kind") == "light" and job["status"] == "queued" and (
                not alive(job.get("client_pid")) or has_flag(job["id"], "cancel")):
            job.update(status="cancelled" if has_flag(job["id"], "cancel") else "lost", finished=time.time())
            save_job(job)
    repair_grants(jobs)
    dispatch_light(jobs)
    ours = [j for j in jobs.values() if j["status"] == "running" or (j["status"] == "queued" and j.get("pgid"))]
    grant = granted()
    note = ""
    if grant:
        job = jobs.get(grant)
        if not job or job["status"] in TERMINAL:
            os.remove(GRANT)
            grant = None
        elif not alive(job.get("client_pid")):
            if job.get("pgid") and group_alive(job["pgid"]):
                note = "%s: its rq client is gone, waiting for the job's processes to end" % grant
            else:
                job.update(status="lost", finished=time.time())
                save_job(job)
                os.remove(GRANT)
                grant = None
        elif job["status"] == "granted" and time.time() - job.get("granted", 0) > 120:
            note = "%s: granted but not started yet" % grant
    if grant:
        job = jobs[grant]
        state["warnings"] = strays(ours)
        state["note"] = note or "running %s" % grant
        return
    for job in jobs.values():  # queued jobs whose session is gone
        if job["status"] == "queued" and job.get("kind") != "light" and (not alive(job.get("client_pid")) or has_flag(job["id"], "cancel")):
            if job.get("pgid") and group_alive(job["pgid"]):  # a moved light job, paused: don't leave it frozen
                try:
                    os.killpg(job["pgid"], signal.SIGCONT)
                    os.killpg(job["pgid"], signal.SIGTERM)
                except ProcessLookupError:
                    pass
            job.update(status="cancelled" if has_flag(job["id"], "cancel") else "lost", finished=time.time())
            save_job(job)
    queued = queue_order([j for j in all_jobs() if j["status"] == "queued" and j.get("kind") != "light"])
    state["warnings"] = strays(ours)
    found = [w for w in state["warnings"] if not w.get("low")]
    if not queued:
        if found:
            state["outside_seen"] = time.time()
        state["note"] = "idle" + (" (outside the queue: %s)" % describe(found) if found else "")
        return
    if found:
        state["outside_seen"] = time.time()
        state["note"] = "waiting: %s running outside the queue" % describe(found)
        return
    quiet = time.time() - state.get("outside_seen", 0)
    if quiet < QUIET_WINDOW:
        state["note"] = "waiting for %d min without outside work (%ds so far)" % (QUIET_WINDOW // 60, quiet)
        return
    job = queued[0]
    give_turn(GRANT, job["id"])
    if job.get("resume_by_dispatcher") and group_alive(job.get("pgid")):  # moved from outside: continue it here
        os.killpg(job["pgid"], signal.SIGCONT)
        job.update(status="running", granted=time.time(), resumed=time.time(), stopped=close_stop(job))
    else:
        job.update(status="granted", granted=time.time())
    save_job(job)
    first = [i for i in (read_json(ORDER, []) or []) if i != job["id"]]
    write_json(ORDER, first)
    state["note"] = "granted %s" % job["id"]


def cmd_daemon(args):
    setup()
    lock = open(os.path.join(STATE, "dispatcher.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        sys.exit("rq: a dispatcher is already running (%s)" % dispatcher_state().get("pid"))
    server = ThreadingHTTPServer(("127.0.0.1", args.port), Page)
    server.daemon_threads = True
    threading.Thread(target=server.serve_forever, daemon=True).start()
    threading.Thread(target=artifact_indexer, daemon=True).start()
    print("rq: dispatcher running, status page on http://localhost:%d" % args.port, flush=True)
    state = {"pid": os.getpid(), "since": time.time(), "port": args.port, "outside_seen": time.time()}
    while True:
        try:
            dispatch_once(state)
        except Exception as e:  # keep dispatching; show the error on the page
            state["note"] = "error: %r" % e
        try:
            state["queue"] = queue_view(all_jobs())  # waiting clients read their place here, not every record
        except Exception as e:
            state.pop("queue", None)
            state["queue_error"] = repr(e)
        try:
            util, gpu_cores = gpu_sample()
            if util is not None:
                samples = (state.get("gpu", {}).get("samples") or [])[-4:] + [util]  # the last 10 s
                state["gpu"] = {"util": round(sum(samples) / len(samples)), "now": util, "cores": gpu_cores,
                                "samples": samples, "at": time.time()}
        except Exception as e:
            state["gpu"] = {"error": repr(e)}
        if time.time() - state.get("usage", {}).get("at", 0) >= 5:
            try:
                state["sessions"] = session_states()
            except Exception as e:
                state["sessions"] = []
                state["sessions_error"] = repr(e)
            try:
                state["usage"] = core_usage()
            except Exception as e:
                state["usage"] = {"at": time.time(), "error": repr(e)}
        state["beat"] = time.time()
        write_json(DISPATCHER, state)
        time.sleep(TICK)


def cmd_start(args):
    """Start the dispatcher detached in its own session, so it outlives the shell and session that started it."""
    if dispatcher_state()["alive"]:
        print("rq: the dispatcher is already running (pid %s)" % dispatcher_state()["pid"])
        return
    if os.fork():
        for _ in range(30):
            time.sleep(0.5)
            d = dispatcher_state()
            if d["alive"] and d.get("since", 0) > time.time() - 60:
                break
        print("rq: dispatcher %s, status page on http://localhost:%d" % (
            "running (pid %s)" % d["pid"] if d["alive"] else "did not start, see " + os.path.join(STATE, "daemon.out"),
            args.port))
        return
    os.setsid()
    if os.fork():
        os._exit(0)
    out = os.open(os.path.join(STATE, "daemon.out"), os.O_WRONLY | os.O_CREAT | os.O_APPEND)
    os.dup2(out, 1)
    os.dup2(out, 2)
    os.dup2(os.open(os.devnull, os.O_RDONLY), 0)
    os.execv(os.path.realpath(__file__), [os.path.realpath(__file__), "daemon", "--port", str(args.port)])


# ---------- client: rq run ----------

def say(text):
    sys.stdout.write("[rq %s] %s\n" % (time.strftime("%H:%M:%S"), text))
    sys.stdout.flush()


def cmd_run(args):
    setup()
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not command:
        sys.exit("rq run: no command (rq run --name NAME -- COMMAND)")
    argv = ["/bin/zsh", "-c", command[0]] if len(command) == 1 else command
    light = args.cmd == "light"
    if light:  # the light queue: one at a time, at low priority, never holds the main queue
        argv = ["nice", "-n", str(QUIET_NICE)] + argv
    project = args.project or project_of(os.getcwd()) or "unknown"
    job = {"id": new_id(project, args.name), "project": project, "name": args.name, "cwd": os.getcwd(),
           "command": " ".join(command), "estimate": parse_duration(args.estimate), "client_pid": os.getpid(),
           "submitted": time.time(), "status": "queued", "kind": "light" if light else "heavy"}
    try:
        job["tools"] = detect_tools(job["command"], job["cwd"])
    except Exception:
        job["tools"] = []
    save_job(job)
    log_path = os.path.join(LOGS, job["id"] + ".log")
    open(log_path, "w").close()
    state = {"job": job, "pgid": None}

    def stop(signum, frame):
        if state["pgid"]:
            set_flag(job["id"], "cancel")
            try:
                os.killpg(state["pgid"], signal.SIGCONT)
                os.killpg(state["pgid"], signal.SIGTERM)
            except ProcessLookupError:
                pass
        else:
            current = load_job(job["id"]) or job
            current.update(status="cancelled", finished=time.time())
            save_job(current)
            say("cancelled while queued")
            sys.exit(130)
    for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(s, stop)

    say("%s %s" % ("light job, queued for the light slot:" if light else "queued", job["id"]))
    say("status page: http://localhost:%d" % (dispatcher_state().get("port") or PORT))
    last, warned, place_cache = None, False, {}
    turn_file = GRANT_LIGHT if light else GRANT
    while True:
        if has_flag(job["id"], "cancel"):
            current = load_job(job["id"]) or job
            current.update(status="cancelled", finished=time.time())
            save_job(current)
            say("cancelled while queued")
            return 130
        if granted(turn_file) == job["id"]:
            break
        position, r, d = queue_place(job["id"], light, place_cache)
        if not d["alive"] and not warned:
            say("warning: the rq dispatcher isn't running; still waiting (the queue session starts it with rq start)")
            warned = True
        status = "waiting%s" % (" for the light slot" if light else "") + (", position %s" % position if position else "")
        if r:
            status += ", %s now: %s/%s" % ("light job" if light else "rendering", r["project"], r["name"])
        elif not light and d.get("note", "").startswith("waiting"):
            status += ", " + d["note"]
        if status != last:
            say(status)
            last = status
        time.sleep(1)

    job = load_job(job["id"]) or job
    say("starting: %s (in %s)" % (job["command"], job["cwd"]))
    with open(log_path, "ab") as log:
        proc = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, start_new_session=True)
        state["pgid"] = proc.pid
        job.update(status="running", started=time.time(), pid=proc.pid, pgid=proc.pid)
        save_job(job)
        subprocess.Popen(["caffeinate", "-i", "-w", str(proc.pid)])
        if light:
            threading.Thread(target=cap_light, args=(job["id"], proc), daemon=True).start()
        fd = proc.stdout.fileno()
        while True:
            chunk = os.read(fd, 65536)
            if not chunk:
                break
            sys.stdout.buffer.write(chunk)
            sys.stdout.flush()
            log.write(chunk)
            log.flush()
        code = proc.wait()
    job = load_job(job["id"]) or job
    cancelled = has_flag(job["id"], "cancel")
    job.update(status="cancelled" if cancelled else ("done" if code == 0 else "failed"), exit=code,
               finished=time.time())
    save_job(job)
    for kind in ("cancel", "paused", "keep"):
        set_flag(job["id"], kind, False)
    say("%s %s: exit %d after %s" % (job["status"], job["id"], code, fmt_duration(job["finished"] - job["started"])))
    return code if code >= 0 else 128 - code


def other_work(job_id):
    """Work a long light job would hold up or compete with: a heavy job running or queued, or a light job waiting."""
    q = dispatcher_state().get("queue")
    if q is not None:  # the dispatcher's published queue: no need to read every record
        return bool(q.get("running") or [i for i in q.get("main", []) if i != job_id]
                    or [i for i in q.get("light", []) if i != job_id])
    for job in all_jobs():
        if job["id"] == job_id:
            continue
        if job.get("kind") == "light" and job["status"] == "queued":
            return job
        if job.get("kind") != "light" and job["status"] in ("queued", "granted", "running"):
            return job
    return None


def cap_light(job_id, proc):
    """A light job that runs longer than LIGHT_CAP while other work is active (a heavy job, or a light job waiting)
    is paused and queued as a heavy job; it continues, with its progress, when it's its turn. Alone, it runs on.
    `rq keep ID` lets it run on in any case."""
    place_cache = {}
    alone_said = False
    while proc.poll() is None:
        time.sleep(2)
        job = load_job(job_id) or {}
        if has_flag(job_id, "keep") or has_flag(job_id, "cancel"):
            return
        if time.time() - job.get("started", time.time()) < LIGHT_CAP:
            continue
        if not other_work(job_id):
            if not alone_said:
                say("running longer than %s as light work, but nothing else is waiting: it runs on"
                    % fmt_duration(LIGHT_CAP))
                alone_said = True
            continue
        try:
            os.killpg(proc.pid, signal.SIGSTOP)
        except ProcessLookupError:
            return
        job.update(kind="heavy", status="queued", promoted=time.time(), submitted=time.time(), stopped=open_stop(job))
        save_job(job)
        say("ran longer than %s as light work while other work is waiting: paused and moved into the queue, "
            "continuing when it's its turn" % fmt_duration(LIGHT_CAP))
        last = None
        while proc.poll() is None:
            if has_flag(job_id, "cancel"):
                return  # cmd_cancel continues and stops the processes
            if granted() == job_id:
                job = load_job(job_id) or job
                job.update(status="running", resumed=time.time(), stopped=close_stop(job))
                save_job(job)
                os.killpg(proc.pid, signal.SIGCONT)
                say("its turn: continuing")
                return
            position, _, _ = queue_place(job_id, False, place_cache)
            if position != last:
                say("paused, waiting in the queue" + (", position %s" % position if position else ""))
                last = position
            time.sleep(TICK)
        return


# ---------- control ----------

def find_job(prefix):
    jobs = [j for j in all_jobs() if j["id"] == prefix] or [j for j in all_jobs() if prefix in j["id"]]
    if len(jobs) != 1:
        sys.exit("rq: %s matches %d jobs" % (prefix, len(jobs)))
    return jobs[0]


def cmd_cancel(args):
    job = find_job(args.id)
    if job["status"] in TERMINAL:
        sys.exit("rq: %s is already %s" % (job["id"], job["status"]))
    set_flag(job["id"], "cancel")
    if job.get("pgid") and group_alive(job["pgid"]):
        os.killpg(job["pgid"], signal.SIGCONT)
        os.killpg(job["pgid"], signal.SIGTERM)
    print("rq: cancelling %s" % job["id"])


def cmd_pause(args, pause=True):
    job = find_job(args.id)
    if job["status"] != "running" or not group_alive(job.get("pgid")):
        sys.exit("rq: %s isn't running" % job["id"])
    os.killpg(job["pgid"], signal.SIGSTOP if pause else signal.SIGCONT)
    set_flag(job["id"], "paused", pause)
    job["stopped"] = open_stop(job) if pause else close_stop(job)
    save_job(job)
    print("rq: %s %s (it keeps its turn)" % ("paused" if pause else "resumed", job["id"]))


def cmd_estimate(args):
    job = find_job(args.id)
    if job["status"] in TERMINAL:
        sys.exit("rq: %s is already %s" % (job["id"], job["status"]))
    seconds = parse_duration(args.duration)
    if not seconds:
        sys.exit("rq: %r isn't a duration (e.g. 45m, 2h30m)" % args.duration)
    job["estimate"] = seconds
    save_job(job)
    print("rq: %s is expected to take %s" % (job["id"], fmt_duration(seconds)))


def cmd_keep(args):
    job = find_job(args.id)
    if job.get("kind") != "light" or job["status"] in TERMINAL:
        sys.exit("rq: %s isn't a running light job" % job["id"])
    set_flag(job["id"], "keep")
    print("rq: %s may run on as light work, past the cap" % job["id"])


def cmd_move(args):
    job = find_job(args.id)
    if args.where == "queue":  # a running light job, paused and moved to the end of the main queue
        if job.get("kind") != "light" or job["status"] != "running" or not group_alive(job.get("pgid")):
            sys.exit("rq: %s isn't a running light job" % job["id"])
        set_flag(job["id"], "keep")  # its own client must not move it again
        os.killpg(job["pgid"], signal.SIGSTOP)
        job.update(kind="heavy", status="queued", promoted=time.time(), submitted=time.time(), stopped=open_stop(job),
                   resume_by_dispatcher=True)
        save_job(job)
        print("rq: paused %s and moved it to the end of the main queue; it continues when it's its turn" % job["id"])
        return
    if job["status"] != "queued":
        sys.exit("rq: %s isn't queued" % job["id"])
    first = [i for i in (read_json(ORDER, []) or []) if i != job["id"]]
    write_json(ORDER, [job["id"]] + first)
    print("rq: %s is next in line" % job["id"])


def cmd_log(args):
    job = find_job(args.id)
    path = os.path.join(LOGS, job["id"] + ".log")
    os.execvp("tail", ["tail", "-n", str(args.n)] + (["-f"] if args.f else []) + [path])


def cmd_status(args):
